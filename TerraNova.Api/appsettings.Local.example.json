{
  // =====================================================================
  // CONFIGURACION LOCAL DE CADA PC
  // 1. Copie este archivo y renombrelo a: appsettings.Local.json
  // 2. Deje SOLO la cadena que corresponda a su SQL Server.
  // appsettings.Local.json NO se sube a GitHub (esta en .gitignore).
  // =====================================================================
  "ConnectionStrings": {
    // SQL Server instalado normal (instancia por defecto) con su usuario de Windows:
    "CadenaSql": "Server=localhost;Database=TerraNovaDB;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"

    // SQL Server EXPRESS:
    // "CadenaSql": "Server=localhost\SQLEXPRESS;Database=TerraNovaDB;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"

    // Con usuario y contraseña de SQL (ej. sa) o en Docker:
    // "CadenaSql": "Server=localhost,1433;Database=TerraNovaDB;User Id=sa;Password=SU_CLAVE;Encrypt=False;TrustServerCertificate=True;"
  },

  // Clave para firmar los tokens de sesion (JWT): cualquier texto largo y secreto (minimo 32 caracteres).
  // Si no la pone, la API usa una temporal y al reiniciarla hay que volver a iniciar sesion.
  "Jwt": {
    "Clave": "CAMBIE-ESTO-por-un-texto-largo-y-secreto-de-al-menos-32-caracteres"
  },

  // Opcional: correo para avisar las visitas (Gmail con "contraseña de aplicación")
  "Smtp": {
    "Usuario": "",
    "Clave": ""
  }
}
