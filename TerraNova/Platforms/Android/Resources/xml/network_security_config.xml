<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad de red: todo el trafico debe ser HTTPS, salvo la API local de desarrollo
     (localhost con "adb reverse" y 10.0.2.2 del emulador). Reemplaza a usesCleartextTraffic="true",
     que permitia HTTP sin cifrar hacia cualquier servidor. -->
<network-security-config>
	<base-config cleartextTrafficPermitted="false" />
	<domain-config cleartextTrafficPermitted="true">
		<domain includeSubdomains="false">localhost</domain>
		<domain includeSubdomains="false">127.0.0.1</domain>
		<domain includeSubdomains="false">10.0.2.2</domain>
	</domain-config>
</network-security-config>
