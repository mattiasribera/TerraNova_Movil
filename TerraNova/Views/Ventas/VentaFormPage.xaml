<?xml version="1.0" encoding="utf-8" ?>
<views:PaginaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:views="clr-namespace:TerraNova.Views"
                  xmlns:vm="clr-namespace:TerraNova.ViewModels"
                  xmlns:c="clr-namespace:TerraNova.Constantes"
                  xmlns:h="clr-namespace:TerraNova.Helpers"
                  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                  xmlns:dto="clr-namespace:TerraNova.Shared;assembly=TerraNova.Shared"
                  x:Class="TerraNova.Views.VentaFormPage"
                  x:DataType="vm:VentaFormViewModel"
                  Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Formulario}" Spacing="14">
            <Border Style="{StaticResource Tarjeta}" Padding="20">
                <VerticalStackLayout>
                    <Label Text="Participantes" Style="{StaticResource TituloSeccion}" Margin="0"/>

                    <Label Text="Cliente" Style="{StaticResource Etiqueta}"/>
                    <Picker ItemsSource="{Binding Clientes}" SelectedItem="{Binding Cliente}"
                            ItemDisplayBinding="{Binding NombreCompleto, x:DataType=dto:ClienteDTO}"/>
                    <Label Text="{Binding Cliente.Ci, StringFormat='CI {0}'}" Style="{StaticResource Secundario}"/>

                    <Label Text="Propiedad" Style="{StaticResource Etiqueta}"/>
                    <Picker ItemsSource="{Binding Propiedades}" SelectedItem="{Binding Propiedad}"
                            ItemDisplayBinding="{Binding Titulo, x:DataType=dto:PropiedadDTO}"/>
                    <Label Style="{StaticResource Secundario}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Propiedad.Zona}"/>
                                <Span Text="  ·  "/>
                                <Span Text="{Binding Propiedad.TipoOperacion}"/>
                                <Span Text="  ·  "/>
                                <Span Text="{Binding Propiedad.PrecioTexto}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="Agente que gestiona la venta" Style="{StaticResource Etiqueta}"/>
                    <Picker ItemsSource="{Binding Trabajadores}" SelectedItem="{Binding Trabajador}" IsEnabled="{Binding EsAdmin}"
                            ItemDisplayBinding="{Binding NombreCompleto, x:DataType=dto:TrabajadorDTO}"/>
                    <Label Text="{Binding Trabajador.PorcentajeComision, StringFormat='Comisión del agente: {0}%'}" Style="{StaticResource Secundario}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="20">
                <VerticalStackLayout>
                    <Label Text="Detalle de la operación" Style="{StaticResource TituloSeccion}" Margin="0"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Monto ($)" Style="{StaticResource Etiqueta}"/>
                            <Entry Text="{Binding Monto}" Keyboard="Numeric">
                                <Entry.Behaviors>
                                    <toolkit:TextValidationBehavior InvalidStyle="{StaticResource Invalido}" ValidStyle="{StaticResource Valido}"
                                                                    Flags="ValidateOnValueChanged" RegexPattern="{x:Static h:Numeros.PatronDecimal}"/>
                                </Entry.Behaviors>
                            </Entry>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Comisión generada (automática)" Style="{StaticResource Etiqueta}"/>
                            <Border BackgroundColor="#FFF8E1" Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="12,10">
                                <Label Text="{Binding Comision, StringFormat='$ {0:N2}'}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Dorado}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Forma de pago" Style="{StaticResource Etiqueta}"/>
                            <Picker ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPago}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Estado" Style="{StaticResource Etiqueta}"/>
                            <Picker ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="Fecha" Style="{StaticResource Etiqueta}"/>
                            <DatePicker Date="{Binding Fecha}" Format="dd/MM/yyyy"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Observaciones" Style="{StaticResource Etiqueta}"/>
                    <Editor Text="{Binding Observaciones}" HeightRequest="80"/>
                    <Label Text="Al guardar, la propiedad pasa a 'Vendida' (o 'Alquilada' si la forma de pago es Alquiler)."
                           Style="{StaticResource Secundario}" Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10" Margin="0,4,0,20">
                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"/>
                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CancelarCommand}"/>
                <Button Text="Guardar venta" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}"
                        ImageSource="{FontImageSource FontFamily=Iconos, Glyph={x:Static c:Iconos.Verificado}, Color=White, Size=16}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:PaginaBase>
