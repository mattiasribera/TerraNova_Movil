<?xml version="1.0" encoding="utf-8" ?>
<views:PaginaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:views="clr-namespace:TerraNova.Views"
                  xmlns:vm="clr-namespace:TerraNova.ViewModels"
                  xmlns:models="clr-namespace:TerraNova.Models"
                  xmlns:controls="clr-namespace:TerraNova.Controls"
                  xmlns:c="clr-namespace:TerraNova.Constantes"
                  xmlns:dto="clr-namespace:TerraNova.Shared;assembly=TerraNova.Shared"
                  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                  x:Class="TerraNova.Views.DashboardPage"
                  x:DataType="vm:DashboardViewModel"
                  Title="Inicio">

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding Cargando}">
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Desktop='28,20', Default='14'}" Spacing="16">
                <VerticalStackLayout>
                    <Label Text="{Binding Saludo}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource Texto}"/>
                    <Label Text="{Binding Datos.Subtitulo}" Style="{StaticResource Secundario}"/>
                </VerticalStackLayout>

                <!-- Indicadores: cambian segun el rol (Admin = empresa, Agente = "mis" datos) -->
                <FlexLayout Wrap="Wrap" Margin="-6,0" BindableLayout.ItemsSource="{Binding Datos.Indicadores}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Indicador">
                            <Border Style="{StaticResource Tarjeta}" Margin="6" FlexLayout.Basis="{OnIdiom Desktop='22%', Default='45%'}" FlexLayout.Grow="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Titulo}" Style="{StaticResource Secundario}"/>
                                        <Label Text="{Binding Valor}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{Binding Color}"/>
                                        <Label Text="{Binding Detalle}" Style="{StaticResource Secundario}" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Style="{StaticResource Icono}" FontSize="28" VerticalOptions="Start"
                                           Text="{Binding Icono}" TextColor="{Binding Color}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Accesos rapidos -->
                <FlexLayout Wrap="Wrap">
                    <Button Text="Nueva propiedad" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"
                            Command="{Binding IrCommand}" CommandParameter="{x:Static c:Rutas.PropiedadForm}"
                            ImageSource="{FontImageSource FontFamily=Iconos, Glyph={x:Static c:Iconos.Propiedades}, Color={StaticResource Verde}, Size=16}"/>
                    <Button Text="Nuevo cliente" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"
                            Command="{Binding IrCommand}" CommandParameter="{x:Static c:Rutas.ClienteForm}"
                            ImageSource="{FontImageSource FontFamily=Iconos, Glyph={x:Static c:Iconos.Clientes}, Color={StaticResource Verde}, Size=16}"/>
                    <Button Text="Registrar venta" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"
                            Command="{Binding IrCommand}" CommandParameter="{x:Static c:Rutas.VentaForm}"
                            ImageSource="{FontImageSource FontFamily=Iconos, Glyph={x:Static c:Iconos.Ventas}, Color={StaticResource Verde}, Size=16}"/>
                    <Button Text="Programar visita" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"
                            Command="{Binding IrCommand}" CommandParameter="{x:Static c:Rutas.VisitaForm}"
                            ImageSource="{FontImageSource FontFamily=Iconos, Glyph={x:Static c:Iconos.Visitas}, Color={StaticResource Verde}, Size=16}"/>
                </FlexLayout>

                <!-- Graficos (ECharts): ventas por mes + dona por estado -->
                <Grid ColumnDefinitions="{OnIdiom Desktop='3*,2*', Default='*'}" RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto'}"
                      ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="Ventas y alquileres (últimos 12 meses)" Style="{StaticResource TituloSeccion}" Margin="0"/>
                            <controls:GraficoECharts Opciones="{Binding Datos.GraficoVentas}" HeightRequest="300"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="{OnIdiom Desktop=1, Default=0}" Grid.Row="{OnIdiom Desktop=0, Default=1}" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Datos.TituloGraficoEstados}" Style="{StaticResource TituloSeccion}" Margin="0"/>
                            <controls:GraficoECharts Opciones="{Binding Datos.GraficoEstados}" HeightRequest="300"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Solo Admin: ranking de comisiones por agente -->
                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding Datos.EsAgente, Converter={toolkit:InvertedBoolConverter}}">
                    <VerticalStackLayout>
                        <Label Text="Comisiones por agente" Style="{StaticResource TituloSeccion}" Margin="0"/>
                        <controls:GraficoECharts Opciones="{Binding Datos.GraficoAgentes}" HeightRequest="260"/>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="{OnIdiom Desktop='*,*', Default='*'}" RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto'}"
                      ColumnSpacing="20" RowSpacing="16">

                    <!-- Agenda: proximas visitas programadas -->
                    <VerticalStackLayout>
                        <Label Text="Próximas visitas" Style="{StaticResource TituloSeccion}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Datos.ProximasVisitas}" Spacing="8">
                            <BindableLayout.EmptyView>
                                <Label Text="No hay visitas programadas" Style="{StaticResource Secundario}"/>
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:VisitaDTO">
                                    <Border Style="{StaticResource Tarjeta}" Padding="10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding VerVisitaCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                                  CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="54,*" ColumnSpacing="12">
                                            <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{StaticResource VerdeClaro}" Padding="0,4">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding FechaVisita, StringFormat='{0:dd}'}" FontSize="20" FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource Verde}" HorizontalOptions="Center"/>
                                                    <Label Text="{Binding FechaVisita, StringFormat='{0:MMM}'}" FontSize="11" TextColor="{StaticResource Verde}" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding IdPropiedadNavigation.Titulo}" Style="{StaticResource TituloTarjeta}" FontSize="14"/>
                                                <Label Style="{StaticResource Secundario}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource IconoSpan}" Text="{x:Static c:Iconos.Reloj}"/>
                                                            <Span Text="{Binding FechaVisita, StringFormat=' {0:HH:mm}'}"/>
                                                            <Span Text="     "/>
                                                            <Span Style="{StaticResource IconoSpan}" Text="{x:Static c:Iconos.Persona}"/>
                                                            <Span Text=" "/>
                                                            <Span Text="{Binding IdClienteNavigation.NombreCompleto}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Admin: actividad reciente  /  Agente: sus propiedades mas recientes -->
                    <VerticalStackLayout Grid.Column="{OnIdiom Desktop=1, Default=0}" Grid.Row="{OnIdiom Desktop=0, Default=1}">
                        <VerticalStackLayout IsVisible="{Binding Datos.EsAgente, Converter={toolkit:InvertedBoolConverter}}">
                            <Label Text="Actividad reciente" Style="{StaticResource TituloSeccion}"/>
                            <Border Style="{StaticResource Tarjeta}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Datos.ActividadReciente}" Spacing="14">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActividadReciente">
                                            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
                                                <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17" Stroke="Transparent"
                                                        BackgroundColor="{StaticResource VerdeClaro}" VerticalOptions="Start">
                                                    <Label Style="{StaticResource Icono}" FontSize="16" Text="{Binding Icono}" HorizontalOptions="Center"/>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="{Binding Descripcion}" TextColor="{StaticResource Texto}" FontSize="14"/>
                                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource Secundario}" FontSize="12"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding Datos.EsAgente}">
                            <Label Text="Mis propiedades recientes" Style="{StaticResource TituloSeccion}"/>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Datos.UltimasPropiedades}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:PropiedadDTO">
                                        <Border Style="{StaticResource Tarjeta}" Padding="10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding VerPropiedadCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                                <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Placeholder}" HeightRequest="52" WidthRequest="64">
                                                    <Grid>
                                                        <Label Style="{StaticResource SinFoto}" FontSize="22" Text="{x:Static c:Iconos.Propiedades}"/>
                                                        <Image Source="{Binding ImagenUrl, Converter={StaticResource FotoAImagen}}" Aspect="AspectFill"/>
                                                    </Grid>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloTarjeta}" FontSize="15"/>
                                                    <Label Text="{Binding PrecioTexto}" Style="{StaticResource Precio}" FontSize="14"/>
                                                </VerticalStackLayout>
                                                <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                        BackgroundColor="{Binding Estado, Converter={StaticResource EstadoAColor}}">
                                                    <Label Text="{Binding Estado}" Style="{StaticResource TextoBadge}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:PaginaBase>
