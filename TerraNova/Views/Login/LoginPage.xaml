<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TerraNova.ViewModels"
             xmlns:c="clr-namespace:TerraNova.Constantes"
             xmlns:controls="clr-namespace:TerraNova.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TerraNova.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}">

    <!-- Windows: panel de marca a la izquierda + formulario a la derecha. Celular: solo el formulario -->
    <Grid ColumnDefinitions="{OnIdiom Desktop='*,*', Default='*'}">

        <Grid BackgroundColor="{StaticResource Verde}" IsVisible="{OnIdiom Desktop=True, Default=False}" Padding="60">
            <VerticalStackLayout VerticalOptions="Center" Spacing="16">
                <Label FontFamily="Iconos" Text="{x:Static c:Iconos.Propiedades}" FontSize="72" TextColor="White"/>
                <Label Text="TerraNova" FontSize="44" FontFamily="OpenSansSemibold" TextColor="White"/>
                <Label Text="Bienes Raíces" FontSize="22" TextColor="#CFE3D3"/>
                <BoxView HeightRequest="2" WidthRequest="80" Color="#CFE3D3" HorizontalOptions="Start" Margin="0,10"/>
                <Label Text="Gestión de propiedades, clientes, ventas y visitas en un solo lugar."
                       FontSize="16" TextColor="#E7F0E9" MaximumWidthRequest="420" HorizontalOptions="Start"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="{OnIdiom Desktop=1, Default=0}" Padding="30">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="{StaticResource Borde}"
                    Padding="32" MaximumWidthRequest="420" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <Label FontFamily="Iconos" Text="{x:Static c:Iconos.Propiedades}" FontSize="44" TextColor="{StaticResource Verde}"
                           HorizontalOptions="Center" IsVisible="{OnIdiom Desktop=False, Default=True}"/>
                    <Label Text="Iniciar sesión" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource Texto}"/>
                    <Label Text="Ingrese sus credenciales para continuar" Style="{StaticResource Secundario}" Margin="0,0,0,10"/>

                    <Label Text="Usuario" Style="{StaticResource Etiqueta}"/>
                    <Entry Text="{Binding NombreUsuario}" Placeholder="Nombre de usuario"/>

                    <Label Text="Contraseña" Style="{StaticResource Etiqueta}"/>
                    <!-- Campo con "ojo" para ver lo que se escribe (Controls/CampoContrasena.cs) -->
                    <controls:CampoContrasena Texto="{Binding Contrasena}" Placeholder="Contraseña"
                                              ComandoEnter="{Binding IniciarSesionCommand}"/>

                    <!-- Servidor de la API: se puede cambiar sin reinstalar la app (ver Services/Configuracion.cs) -->
                    <Label Text="Servidor" Style="{StaticResource Etiqueta}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding UrlServidor}" Placeholder="https://servidor-de-terranova"
                               Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        <Button Grid.Column="1" Text="Restablecer" Style="{StaticResource BotonSecundario}"
                                Command="{Binding RestablecerServidorCommand}"/>
                    </Grid>

                    <Label Text="{Binding MensajeError}" TextColor="{StaticResource Rojo}" Margin="0,6,0,0"
                           IsVisible="{Binding MensajeError, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

                    <Button Text="Ingresar" Style="{StaticResource BotonPrimario}" Margin="0,16,0,0"
                            Command="{Binding IniciarSesionCommand}"/>
                    <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
