<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TerraNova.MainPage"
             BackgroundColor="#F4F1EA">

    <!-- Inv: estilos que aplica el NumericValidationBehavior -->
    <ContentPage.Resources>
        <Style x:Key="Invalido" TargetType="Entry">
            <Setter Property="TextColor" Value="Green"/>
        </Style>
        <Style x:Key="Valido" TargetType="Entry">
            <Setter Property="TextColor" Value="Black"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,10" Spacing="15">

            <Label Text="TERRANOVA BIENES RAICES"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1E5631"
                   HorizontalOptions="Center"/>
            <Label Text="Registrar propiedad"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Texto libre -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="TITULO" TextColor="Black"/>
                    <Entry x:Name="Titulo" TextColor="Black" Placeholder="Ej: Casa con jardin"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="ZONA" TextColor="Black"/>
                    <Entry x:Name="Zona" TextColor="Black" Placeholder="Ej: Equipetrol"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Texto en lista  /  Fecha -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="TIPO" TextColor="Black"/>
                    <Picker x:Name="Tipo" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>CASA</x:String>
                                <x:String>DEPARTAMENTO</x:String>
                                <x:String>TERRENO</x:String>
                                <x:String>OFICINA</x:String>
                                <x:String>LOCAL</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="FECHA DE PUBLICACION" TextColor="Black"/>
                    <DatePicker x:Name="Fecha" TextColor="Black" Format="dd-MM-yyyy"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Radio button -->
            <Label Text="TIPO DE OPERACION" TextColor="Black"/>
            <HorizontalStackLayout Spacing="25">
                <RadioButton x:Name="Rb1" Content="VENTA" GroupName="Operacion" IsChecked="True"/>
                <RadioButton x:Name="Rb2" Content="ALQUILER" GroupName="Operacion"/>
            </HorizontalStackLayout>

            <!-- Numericos con validacion del CommunityToolkit.Maui -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="PRECIO ($)" TextColor="Black"/>
                    <Entry x:Name="Precio" Keyboard="Numeric" Placeholder="Ej: 85000">
                        <Entry.Behaviors>
                            <toolkit:NumericValidationBehavior
                                x:Name="ValidaPrecio"
                                InvalidStyle="{StaticResource Invalido}"
                                ValidStyle="{StaticResource Valido}"
                                Flags="ValidateOnValueChanged"
                                MinimumValue="1"
                                MaximumValue="10000000"
                                MaximumDecimalPlaces="0"/>
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="AREA (M2)" TextColor="Black"/>
                    <Entry x:Name="Area" Keyboard="Numeric" Placeholder="Ej: 250">
                        <Entry.Behaviors>
                            <toolkit:NumericValidationBehavior
                                x:Name="ValidaArea"
                                InvalidStyle="{StaticResource Invalido}"
                                ValidStyle="{StaticResource Valido}"
                                Flags="ValidateOnValueChanged"
                                MinimumValue="1"
                                MaximumValue="100000"
                                MaximumDecimalPlaces="0"/>
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>
            </Grid>

            <Button x:Name="BtnGuardar"
                    Text="REGISTRAR PROPIEDAD"
                    BackgroundColor="#1E5631"
                    Clicked="Procesar"/>

            <!-- Grid donde se muestra el vector -->
            <Border Stroke="#1E5631"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="White"
                    Padding="5">
                <Grid x:Name="Dgv" ColumnSpacing="5" RowSpacing="4" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="TITULO" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="ZONA" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="TIPO" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="OPERACION" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="FECHA" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="5" Text="PRECIO $" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="6" Text="AREA M2" FontAttributes="Bold" TextColor="#1E5631" HorizontalTextAlignment="Center"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>